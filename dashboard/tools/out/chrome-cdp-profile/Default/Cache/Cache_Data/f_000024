// ═══════════════ ASVK Chart client — BTC 1h ═══════════════
// Экран рассчитан на постоянную работу (kiosk-режим): пайплайн ASVK каждые 15 мин
// подтягивает новые бары, часовая свеча "едет" вперёд сама — старая уходит влево,
// новая появляется в запасе места справа (rightOffset). followingLive отслеживает,
// смотрит ли пользователь на живой край; если да — окно само переезжает на каждый
// ресинк, если пользователь отскроллил в историю — не дёргаем его вид.
const WEEK_BARS = 7 * 24;             // 168 часовых баров
const RIGHT_MARGIN_BARS = 20;         // свободных баров справа от последней свечи
const LIVE_EDGE_TOLERANCE_BARS = 2;   // допуск "у живого края"
// LightweightCharts всегда форматирует ось времени и crosshair-подпись в UTC — своей
// настройки таймзоны у неё нет. Сдвигаем "time" на +3ч при получении с сервера (сервер
// отдаёт честный UTC), библиотека рисует эти сдвинутые метки как "UTC" — по факту
// получается корректный MSK на экране. Данные на диске остаются в UTC, это только
// display-слой (project internals stay UTC, chat/display — MSK).
const MSK_SHIFT_SEC = 3 * 3600;
let chart, series, wmaSeries, chartEl, bandCanvas, bandCtx, signalCanvas, signalCtx;
let lastCandles = [];
let lastSignals = [];
let firstLoad = true;
let currentRange = null;    // последний применённый видимый logical-диапазон {from,to}
let followingLive = true;   // true = держим rolling-неделю; false = юзер сам навигирует

function resizeChart() {
    if (!chart || !chartEl) return;
    chart.applyOptions({ width: chartEl.clientWidth, height: chartEl.clientHeight });
    // applyOptions с новой шириной по умолчанию держит barSpacing константным, а не
    // видимый диапазон — на резком расширении (fullscreen) это подтягивает лишние бары
    // (неделя → 20 дней). Переприменяем нужный диапазон явно, чтобы окно не "плыло".
    if (followingLive) applyRollingWindow();
    else if (currentRange) chart.timeScale().setVisibleLogicalRange(currentRange);
}

function makeChart() {
    const el = document.getElementById("chart");
    chartEl = el;
    chart = LightweightCharts.createChart(el, {
        layout: {
            // Прозрачный фон — иначе непрозрачный canvas самого чарта полностью
            // перекрывает band-canvas, стоящий за ним по z-index (не только свечи).
            // Видимый белый фон даёт .chart-panel (CSS) под обоими canvas.
            background: { type: "solid", color: "rgba(0,0,0,0)" },
            textColor: "#333333",
            fontSize: 10,
        },
        grid: {
            vertLines: { visible: false },
            horzLines: { visible: false },
        },
        rightPriceScale: { borderColor: "#d0d0d0", scaleMargins: { top: 0.08, bottom: 0.08 } },
        timeScale: { borderColor: "#d0d0d0", timeVisible: true, secondsVisible: false, rightOffset: 20 },
        crosshair: {
            mode: LightweightCharts.CrosshairMode.Normal,
            vertLine: { color: "#7d8590", width: 1, style: 2 },
            horzLine: { color: "#7d8590", width: 1, style: 2 },
        },
    });
    // WMA(50) добавлена ДО свечей — в LightweightCharts позже добавленный series рисуется
    // поверх раньше добавленных, так что свечи (ниже) окажутся визуально сверху линии WMA,
    // а не она поверх свечей. Цвет #3861f6 — сэмплирован напрямую из WMA_TRENDLINE
    // пример.png (доминирующий blue-кластер, 1259 пикселей).
    wmaSeries = chart.addLineSeries({
        color: "#3861f6", lineWidth: 1, priceLineVisible: false, lastValueVisible: false,
        crosshairMarkerVisible: false, title: "WMA50",
    });

    series = chart.addCandlestickSeries({
        upColor: "#01a648", downColor: "#0e3c46",
        borderUpColor: "#01a648", borderDownColor: "#0e3c46",
        wickUpColor: "#01a648", wickDownColor: "#0e3c46",
    });

    // HMA(78)/trendline — НЕ линия, а лента: fill_between(upper, lower), как в исходном
    // ~/traid-bot/research/asvk_trend_line/plot_asvk_trend_line.py (canon), см. drawBand().
    // LightweightCharts не умеет заливку между двумя произвольными линиями нативно —
    // рисуем поверх свечей отдельным canvas-оверлеем (band-canvas в index.html).
    bandCanvas = document.getElementById("band-canvas");
    bandCtx = bandCanvas.getContext("2d");

    // Сигналы 12h-фрактал (basket B1∪B9) — стрелка + столбик условий, НАД свечами
    // (signal-canvas z-index 3 > chart-container z-index 2), см. drawSignals().
    signalCanvas = document.getElementById("signal-canvas");
    signalCtx = signalCanvas.getContext("2d");

    // Запоминаем видимый (logical, по индексам баров) диапазон при любом изменении —
    // программном или ручном pan/zoom. Если правый край диапазона близко к индексу
    // последней свечи — юзер "у живого края", rolling-window продолжит возвращать его
    // туда на каждый ресинк. Если отскроллил в историю — просто запоминаем вид.
    chart.timeScale().subscribeVisibleLogicalRangeChange((range) => {
        if (!range) return;
        currentRange = range;
        const lastIdx = lastCandles.length - 1;
        followingLive = lastCandles.length > 0 && (lastIdx - range.to) <= LIVE_EDGE_TOLERANCE_BARS;
    });
    chart.subscribeCrosshairMove(onCrosshairMove);

    new ResizeObserver(resizeChart).observe(el);
    // ResizeObserver иногда не триггерится надёжно на fullscreen/maximize (headless-CDP
    // тест это подтвердил: контейнер стретчится, а таймскейл — нет) — window resize
    // как резервный триггер того же пересчёта ширины.
    window.addEventListener("resize", resizeChart);
    resizeChart();
}

function applyRollingWindow() {
    if (!lastCandles.length) return;
    // setVisibleRange (по времени) обрезает "to" по границе реальных данных — margin
    // справа через него не поставить. setVisibleLogicalRange по индексам баров умеет
    // уходить за пределы последней свечи — штатный способ показать пустое место.
    const lastIdx = lastCandles.length - 1;
    currentRange = { from: lastIdx - WEEK_BARS, to: lastIdx + RIGHT_MARGIN_BARS };
    chart.timeScale().setVisibleLogicalRange(currentRange);
    followingLive = true;
}

// ─── Trend band overlay (fill_between upper/lower, canon-стиль) ───
function drawBand() {
    if (!bandCtx || !chart || !series || !chartEl) return;
    const dpr = window.devicePixelRatio || 1;
    const w = chartEl.clientWidth, h = chartEl.clientHeight;
    const pw = Math.round(w * dpr), ph = Math.round(h * dpr);
    if (bandCanvas.width !== pw || bandCanvas.height !== ph) {
        bandCanvas.width = pw;
        bandCanvas.height = ph;
    }
    bandCtx.setTransform(dpr, 0, 0, dpr, 0, 0);
    bandCtx.clearRect(0, 0, w, h);
    if (!lastCandles.length) return;

    const ts = chart.timeScale();
    const pts = [];
    for (const c of lastCandles) {
        if (c.hma78_upper == null || c.hma78_lower == null || !c.hma78_dir) continue;
        const x = ts.timeToCoordinate(c.time);
        const yU = series.priceToCoordinate(c.hma78_upper);
        const yL = series.priceToCoordinate(c.hma78_lower);
        if (x == null || yU == null || yL == null) continue;
        pts.push({ x, yU, yL, dir: c.hma78_dir });
    }
    if (!pts.length) return;

    // Сэмплировано напрямую из WMA_TRENDLINE пример.png (доминирующие кластеры в
    // гистограмме band-зон) — сплошная заливка, не полупрозрачная (референс уже даёт
    // итоговый смешанный с фоном цвет, alpha тут не нужна).
    const UP = "#a7d0a3", DOWN = "#e8959a";
    let runStart = 0;
    for (let i = 1; i <= pts.length; i++) {
        if (i === pts.length || pts[i].dir !== pts[runStart].dir) {
            // +1 точка на границе (первая точка следующего рана) — иначе между
            // разноцветными полигонами остаётся видимая щель на стыке тренда.
            const run = pts.slice(runStart, Math.min(i + 1, pts.length));
            bandCtx.beginPath();
            bandCtx.moveTo(run[0].x, run[0].yU);
            for (const p of run) bandCtx.lineTo(p.x, p.yU);
            for (let j = run.length - 1; j >= 0; j--) bandCtx.lineTo(run[j].x, run[j].yL);
            bandCtx.closePath();
            bandCtx.fillStyle = run[0].dir === "up" ? UP : DOWN;
            bandCtx.fill();
            runStart = i;
        }
    }
}

// ─── Fractal-12h signal markers (basket B1∪B9) — стрелка + столбик условий ───
// LONG: стрелка ПОД баром (у low), остриё вверх — "толкает" цену вверх, как buy-маркер
// в TradingView. SHORT: стрелка НАД баром (у high), остриё вниз.
// Это live-график: сигнал рисуется сразу, как только сформировался (basket_hit),
// одинаково для pending/confirmed/failed — НЕ постфактум, задним числом, по тому,
// сработал он в итоге или нет. Ретроспективная фильтрация/раскраска по исходу здесь
// намеренно не делается (явная просьба пользователя после сигнала 19-07, который
// в итоге не подтвердился, но должен быть виден как и любой другой).
// Список условий (B1C2, B9C1, ...) — столбик дальше от бара, чем сама стрелка,
// по одному условию на строку (как просил пользователь — "перечислялись в столбик").
function drawSignals() {
    if (!signalCtx || !chart || !series || !chartEl) return;
    const dpr = window.devicePixelRatio || 1;
    const w = chartEl.clientWidth, h = chartEl.clientHeight;
    const pw = Math.round(w * dpr), ph = Math.round(h * dpr);
    if (signalCanvas.width !== pw || signalCanvas.height !== ph) {
        signalCanvas.width = pw;
        signalCanvas.height = ph;
    }
    signalCtx.setTransform(dpr, 0, 0, dpr, 0, 0);
    signalCtx.clearRect(0, 0, w, h);
    if (!lastSignals.length || !lastCandles.length) return;

    const ts = chart.timeScale();
    const LONG_COLOR = "#01a648", SHORT_COLOR = "#d64550";
    const ARROW_GAP = 6, ARROW_H = 16, ARROW_HALF_W = 10, TEXT_GAP = 8, LINE_H = 11;
    signalCtx.font = "700 10px 'SF Mono', Menlo, Consolas, monospace";
    signalCtx.textAlign = "center";

    for (const sig of lastSignals) {
        const candle = lastCandles.find((c) => c.time === sig.time);
        if (!candle) continue;
        const x = ts.timeToCoordinate(sig.time);
        if (x == null) continue;

        const isLong = sig.direction === "long";
        const color = isLong ? LONG_COLOR : SHORT_COLOR;
        const anchorPrice = isLong ? candle.low : candle.high;
        const yAnchor = series.priceToCoordinate(anchorPrice);
        if (yAnchor == null) continue;

        const sign = isLong ? 1 : -1;   // +1 = вниз по экрану (под баром), -1 = вверх (над баром)
        const tipY = yAnchor + sign * ARROW_GAP;
        const baseY = tipY + sign * ARROW_H;

        signalCtx.beginPath();
        signalCtx.moveTo(x, tipY);
        signalCtx.lineTo(x - ARROW_HALF_W, baseY);
        signalCtx.lineTo(x + ARROW_HALF_W, baseY);
        signalCtx.closePath();
        signalCtx.fillStyle = color;
        signalCtx.fill();

        let ly = baseY + sign * (TEXT_GAP + (sign > 0 ? LINE_H : 0));
        for (const cond of sig.conditions) {
            signalCtx.fillText(cond, x, ly);
            ly += sign * LINE_H;
        }
    }
}

// LightweightCharts не даёт единого события "что-то перерисовалось" (pan/zoom/autoscale/
// resize) — синхронизируем оба canvas-оверлея через requestAnimationFrame, как рекомендует
// сообщество для custom-оверлеев поверх этой библиотеки. rAF сам встаёт на паузу на
// неактивной вкладке.
function overlayLoop() {
    drawBand();
    drawSignals();
    requestAnimationFrame(overlayLoop);
}

async function loadCandles() {
    try {
        const r = await fetch("/api/candles?tf=1h&limit=500");
        const data = await r.json();
        for (const c of data) c.time += MSK_SHIFT_SEC;
        if (data.length) {
            lastCandles = data;
            series.setData(data);
            wmaSeries.setData(data.filter((c) => c.wma50 != null).map((c) => ({ time: c.time, value: c.wma50 })));
            updateLegend(data[data.length - 1], data[data.length - 2]);
            // Rolling window: на первой загрузке — всегда; дальше — только пока юзер
            // "у живого края" (иначе не дёргаем его ручной скролл каждые 60с).
            if (firstLoad || followingLive) applyRollingWindow();
            firstLoad = false;
        }
    } catch (e) { console.error("candles", e); }
}

async function loadSignals() {
    try {
        const r = await fetch("/api/signals/fractal12h?symbol=BTC");
        const data = await r.json();
        for (const s of data) s.time += MSK_SHIFT_SEC;
        lastSignals = data;
    } catch (e) { console.error("signals", e); }
}

// ─── OHLC legend (TV-style top-left readout) ───
function fmtVol(v) {
    if (v == null) return "—";
    if (v >= 1e6) return (v / 1e6).toFixed(2) + "M";
    if (v >= 1e3) return (v / 1e3).toFixed(1) + "K";
    return v.toFixed(2);
}

function updateLegend(c, prev) {
    if (!c) return;
    document.getElementById("lg-o").textContent = fmtPrice(c.open);
    document.getElementById("lg-h").textContent = fmtPrice(c.high);
    document.getElementById("lg-l").textContent = fmtPrice(c.low);
    document.getElementById("lg-c").textContent = fmtPrice(c.close);
    document.getElementById("lg-vol").textContent = fmtVol(c.volume);
    const chgEl = document.getElementById("lg-chg");
    const base = prev ? prev.close : c.open;
    const pct = base ? ((c.close - base) / base) * 100 : 0;
    chgEl.className = "val chg " + (pct >= 0 ? "up" : "down");
    chgEl.textContent = `${pct >= 0 ? "+" : ""}${pct.toFixed(2)}%`;
}

function onCrosshairMove(param) {
    if (!param || !param.time || !lastCandles.length) {
        const last = lastCandles[lastCandles.length - 1];
        const prev = lastCandles[lastCandles.length - 2];
        updateLegend(last, prev);
        return;
    }
    const idx = lastCandles.findIndex((c) => c.time === param.time);
    if (idx === -1) return;
    updateLegend(lastCandles[idx], lastCandles[idx - 1]);
}

function fmtPrice(p) {
    if (p == null) return "—";
    return Math.round(p).toLocaleString("en-US");
}

function renderPrice(d) {
    const priceEl = document.getElementById("price");
    const chgEl = document.getElementById("chg");
    if (!d || d.price == null) { priceEl.textContent = "—"; chgEl.textContent = ""; return; }
    priceEl.textContent = "$" + fmtPrice(d.price);
    const cls = d.change_pct_24h >= 0 ? "up" : "down";
    const arrow = d.change_pct_24h >= 0 ? "▲" : "▼";
    chgEl.className = "chg " + cls;
    chgEl.textContent = `${arrow} ${Math.abs(d.change_pct_24h).toFixed(2)}% (24h)`;
}

function markLive(alive) {
    document.getElementById("live-dot").className = "live-dot" + (alive ? "" : " stale");
}

function tickClock() {
    // Date.now() — UTC ms, тайзон-независимо. toTimeString() же всегда рендерит в
    // системной локальной зоне браузера/ОС — старая формула через getTimezoneOffset()
    // была корректна только случайно (когда system TZ уже = UTC+3). toISOString() на
    // уже сдвинутом +3ч таймстампе не трогает локальную зону вообще — надёжно везде.
    const mskIso = new Date(Date.now() + 3 * 3600 * 1000).toISOString();
    document.getElementById("clock").textContent = mskIso.slice(11, 19) + " MSK";
}
setInterval(tickClock, 1000);
tickClock();

// ─── WebSocket — live tick + текущая (незакрытая) свеча ───
let lastMsgAt = 0;
function connectWS() {
    const ws = new WebSocket(`${location.protocol === "https:" ? "wss" : "ws"}://${location.host}/ws`);
    ws.onmessage = (ev) => {
        try {
            const m = JSON.parse(ev.data);
            if (m.type === "tick") {
                lastMsgAt = Date.now();
                renderPrice(m.price);
                if (m.candle) {
                    m.candle.time += MSK_SHIFT_SEC;
                    series.update(m.candle);
                    const last = lastCandles[lastCandles.length - 1];
                    if (last && last.time === m.candle.time) Object.assign(last, m.candle);
                }
            }
        } catch (e) { console.error("ws parse", e); }
    };
    ws.onclose = () => setTimeout(connectWS, 3000);
    ws.onerror = () => ws.close();
    setInterval(() => { try { ws.send("ping"); } catch (_) {} }, 20000);
}
setInterval(() => markLive(Date.now() - lastMsgAt < 15000), 2000);

// ─── Controls ───
function wireControls() {
    let logMode = false;
    document.getElementById("btn-auto").addEventListener("click", () => {
        chart.priceScale("right").applyOptions({ autoScale: true });
        chart.timeScale().fitContent();
        currentRange = chart.timeScale().getVisibleLogicalRange();
        followingLive = false;   // показали всю загруженную историю — не откатывать на неделю
    });
    document.getElementById("btn-log").addEventListener("click", (ev) => {
        logMode = !logMode;
        ev.target.classList.toggle("active", logMode);
        chart.priceScale("right").applyOptions({
            mode: logMode ? LightweightCharts.PriceScaleMode.Logarithmic : LightweightCharts.PriceScaleMode.Normal,
        });
    });
}

// ─── Boot ───
async function boot() {
    makeChart();
    wireControls();
    requestAnimationFrame(overlayLoop);
    await loadCandles();
    await loadSignals();
    try {
        const p = await fetch("/api/price").then(r => r.json());
        renderPrice(p);
    } catch (e) { console.error("boot price", e); }
    connectWS();
    setInterval(loadCandles, 60000);   // полный ресинк раз в минуту
    setInterval(loadSignals, 60000);   // новые сигналы basket'а — та же частота
}
boot();
